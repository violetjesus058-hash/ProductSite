/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/kakobuy-catalog.csv
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment; filename="kakobuy-catalog.csv"
  Cache-Control: public, max-age=3600
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

# Vite build assets are content-hashed: safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Product images keep their filename across rebuilds, so use a shorter window
# with background revalidation instead of immutable caching.
/product-images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
